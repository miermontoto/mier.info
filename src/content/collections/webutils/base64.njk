---
title: base64
desc: 'encode/decode base64'
redirect_from: /webutils/base64/
---

{# macro reutilizable: panel de conversión con su botón de copiar.
   centraliza el markup compartido por ambos convertidores #}
{% macro panel(side, copyId) %}
<div class="{{ side }}">
	{{ caller() }}
	<span class="button" id="{{ copyId }}" title="Copy to clipboard">⎘</span>
</div>
{% endmacro %}

<div class="converter">
	<div class="tabs" role="tablist">
		<button type="button" class="tab active" data-tab="text" role="tab">text</button>
		<button type="button" class="tab" data-tab="images" role="tab">images</button>
	</div>

	{# convertidor de texto #}
	<div class="tab-panel" data-panel="text">
		{% call panel('decoded', 'decoded-copy') %}
			<textarea class="input" id="decoded-text" placeholder="plain text"></textarea>
		{% endcall %}
		<span class="arrow">&lt;=></span>
		{% call panel('encoded', 'encoded-copy') %}
			<textarea class="output" id="encoded-text" placeholder="encoded text"></textarea>
		{% endcall %}
	</div>

	{# convertidor de imágenes: imagen <=> base64 #}
	<div class="tab-panel hidden" data-panel="images">
		{% call panel('decoded', 'img-copy') %}
			<div id="img-drop" onclick="document.getElementById('img-input').click()">
				<span class="info">Drop an image here or click to select</span>
				<input type="file" id="img-input"
					accept="image/png, image/jpeg, image/svg+xml, image/webp, image/ico, image/bmp">
				<img id="decoded-img" hidden alt="Decoded image">
			</div>
		{% endcall %}
		<span class="arrow">&lt;=></span>
		{% call panel('encoded', 'img-encoded-copy') %}
			<textarea class="output" id="img-encoded-text" placeholder="base64 image data"></textarea>
		{% endcall %}
	</div>
</div>
